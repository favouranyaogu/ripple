[TEMPLATE]
[TEMPLATE]
# Neon Postgres Database Configuration
DATABASE_URL=postgres://user:password@ep-cool-name-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# AI / Gemini Configuration (clusters raw posts into issues)
GEMINI_API_KEY=your-gemini-api-key

# Web search (Tavily) — powers the default web platform
TAVILY_API_KEY=tvly-your-tavily-api-key

# X / Twitter API — app-only bearer token (X Developer Portal → Project → Keys)
TWITTER_BEARER_TOKEN=your-app-only-bearer-token
# Default daily X API spend cap (USD). The scan route skips X once today's
# spend plus the projected cost of a scan would exceed this. Can be adjusted
# live from the Monitor page (stored as an override in the settings table).
X_DAILY_BUDGET=3.00
# Max results requested per X scan (clamped to the API's valid 10-100 range).
X_MAX_RESULTS_PER_SCAN=20

# Reddit API — OAuth2 client credentials (reddit.com/prefs/apps → create app → script)
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
# Reddit now requires pre-approval for new API apps. While your access request
# is in review, set this to true so the health card shows Reddit as "pending"
# instead of "unconfigured". Remove it once you have working credentials.
REDDIT_API_REQUESTED=true

# Bluesky — handle + app password (settings → App Passwords)
BLUESKY_HANDLE=your-handle.bsky.social
BLUESKY_APP_PASSWORD=your-app-password
